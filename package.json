{
  "name": "badminton-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Coach-only badminton academy manager — offline-first PWA (V1 scaffold).",
  "scripts": {
    "dev": "vite --host",
    "server": "node server/index.js",
    "dev:all": "concurrently -n vite,api -c cyan,green \"vite\" \"node server/index.js\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.6.1",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.1"
  }
}
