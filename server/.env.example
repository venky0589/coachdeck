# Copy this file to server/.env and fill it in. server/.env is gitignored —
# never commit real credentials.

# --- Postgres connection (required) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=badminton_coach
DB_USER=postgres
DB_PASSWORD=

# Set true for a managed Postgres that requires TLS (e.g. Neon). Leave false
# for a local/self-hosted Postgres with no TLS listener.
DB_SSL=false

# --- API key (recommended to set explicitly) ---
# Every request to /rest/v1/* and /api/* must carry this as a Bearer token.
# If you leave this blank, the server generates one on first run and prints
# it to the console (also saved to server/.generated-api-key so restarts
# reuse it). Whatever value ends up here must exactly match
# VITE_SUPABASE_ANON_KEY in the app's .env.local — that's the header
# @supabase/supabase-js already sends on every request.
API_KEY=

# --- Network binding ---
# Defaults to 127.0.0.1 (only this machine can reach the server). Set this to
# 0.0.0.0 to let your phone reach it over Wi-Fi for sync, or when deploying to
# a host like Render that proxies in from outside the container — only do
# that on a network/host you trust, and keep the API key private.
HOST=127.0.0.1
PORT=3001

# Comma-separated extra origins to allow, beyond localhost and private-LAN
# addresses (10.x/172.16-31.x/192.168.x) on any port, which are always
# allowed automatically. Required for a public host like Render — e.g.
# ALLOWED_ORIGINS=https://your-app.onrender.com
ALLOWED_ORIGINS=
